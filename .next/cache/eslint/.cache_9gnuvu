u/Documents/coding/React/text-askme TEXT Q&A 2/src/components/emoji/EmojiContainer.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/components/header/GuestHeader.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/components/header/index.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/components/input/InputField.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/components/modal/index.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/components/modal/modal-events-options.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/components/room/information.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/components/room/messages.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/components/rooms/RoomsList.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/components/scroll-to-top-button/ScrollToTopButton.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/components/submit-questions-container/SubmitAnswersContainer.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/components/submit-questions-container/SubmitQuestionsContainer.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/context/app.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/hooks/room.js",["243"],[],"// Hook responsible for QUESTIONS\n\nimport { add } from \"date-fns\";\nimport { useEffect, useState } from \"react\";\n\nconst useRoom = (room) => {\n  const [questions, setQuestions] = useState([]);\n  const [error, setError] = useState(false);\n\n  useEffect(() => {\n    const fetchingRoomsOne = async () => {\n      if (!room) return;\n      try {\n        const res = await fetch(\n          `/api/database?collection=questions&eventId=${room._id}`\n        );\n        const data = await res.json();\n        // no need for a function to ensure it's an array\n        setQuestions(data);\n      } catch (err) {\n        console.error(err.message);\n        setError(true);\n      }\n    };\n    fetchingRoomsOne();\n  }, [room?._id]);\n\n  const createQuestionApi = async (payload) => {\n    if (!payload) return;\n\n    try {\n      const res = await fetch(`/api/database?collection=questions`, {\n        method: \"POST\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify(payload),\n      });\n      if (!res) {\n        throw new Error(\"ERROR, as res is not okay.\");\n      }\n      const data = await res.json();\n\n      const addingToPrev = (prev) => {\n        const adding = [data, ...prev];\n        return adding;\n      };\n\n      setQuestions(addingToPrev);\n    } catch (err) {\n      console.error(err.message);\n    }\n  };\n\n  const deleteQuestionApi = async (id) => {\n    if (!id) return;\n\n    try {\n      const res = await fetch(`/api/database?collection=questions&id=${id}`, {\n        method: \"DELETE\",\n      });\n\n      if (!res.ok) {\n        throw new Error(\"ERROR, as res is not okay.\");\n      }\n\n      const deleteFunction = (prev) => {\n        const remaining = prev.filter((question) => question._id !== id);\n        return remaining;\n      };\n\n      setQuestions(deleteFunction);\n    } catch (err) {\n      console.error(err.message);\n    }\n  };\n\n  const updateQuestionApi = async (id, payload) => {\n    if (!id || !payload) return;\n\n    try {\n      const res = await fetch(`/api/database?collection=questions&id=${id}`, {\n        method: \"PUT\",\n        headers: {\n          \"Content-Type\": \"application/json\",\n        },\n        body: JSON.stringify(payload),\n      });\n\n      if (!res.ok) {\n        throw new Error(\"ERROR, as res is not okay.\");\n      }\n\n      const updatingFunction = (prev) => {\n        const updated = prev.map((q) =>\n          q._id === id ? { ...q, ...payload } : q\n        );\n        return updated;\n      };\n\n      setQuestions(updatingFunction);\n    } catch (err) {\n      console.error(err.message);\n    }\n  };\n\n  return {\n    questions,\n    setQuestions,\n    room,\n    createQuestionApi,\n    deleteQuestionApi,\n    updateQuestionApi,\n  };\n};\n\nexport default useRoom;\n","/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/lib/auth0.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/middleware.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/models/Question.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/pages/FadeOutElement.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/pages/api/database.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/pages/api/upload.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/pages/api/verify-pin.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/pages/dashboard.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/pages/event-pin.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/pages/events/[id]/NameInput.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/pages/events/[id]/edit.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/pages/events/[id].js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/pages/index.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/pages/users-profile.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-askme TEXT Q&A 2/src/utils/dates.js",[],[],"/Users/isaacolarewaju/Documents/coding/React/text-ask